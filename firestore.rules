rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidStringList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 600));
    }

    function isValidBrief(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'topic', 'industry', 'briefType', 'signalStrength',
          'lifecyclePhase', 'leadTimeMonths', 'confidencePct', 'executiveSummary',
          'drivers', 'barriers', 'metrics', 'sections', 'sources',
          'isArchived', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'topic', 'industry', 'briefType', 'signalStrength',
          'lifecyclePhase', 'leadTimeMonths', 'confidencePct', 'executiveSummary',
          'drivers', 'barriers', 'metrics', 'sections', 'sources', 'history',
          'isArchived', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && isValidString(data.topic, 2, 240)
        && isValidString(data.industry, 2, 120)
        && data.briefType in ['trend-brief', 'market-map', 'opportunity-assessment', 'tech-scouting']
        && data.signalStrength in ['Weak', 'Moderate', 'Strong']
        && data.lifecyclePhase in ['Emergence', 'Growth', 'Maturity', 'Decline']
        && isValidString(data.leadTimeMonths, 1, 60)
        && data.confidencePct is number
        && data.confidencePct >= 0 && data.confidencePct <= 100
        && isValidString(data.executiveSummary, 10, 5000)
        && isValidStringList(data.drivers, 12)
        && isValidStringList(data.barriers, 12)
        && data.metrics is map
        && data.metrics.keys().size() <= 16
        && data.sections is map
        && data.sections.keys().size() <= 12
        && data.sources is list
        && data.sources.size() <= 25
        && (data.sources.size() == 0 || data.sources[0] is map)
        && (!('history' in data) || (
          data.history is list
          && data.history.size() <= 24
          && (data.history.size() == 0 || (
            data.history[0] is map
            && data.history[0].keys().hasAll(['timestamp', 'lifecyclePhase', 'signalStrength', 'note'])
            && data.history[0].lifecyclePhase in ['Emergence', 'Growth', 'Maturity', 'Decline']
            && data.history[0].signalStrength in ['Weak', 'Moderate', 'Strong']
            && isValidString(data.history[0].timestamp, 4, 60)
            && isValidString(data.history[0].note, 1, 600)
          ))
        ))
        && data.isArchived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistSignal(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'topic', 'industry', 'signalStrength', 'lifecyclePhase',
          'cadence', 'alertThreshold', 'latestDeltaNote', 'linkedBriefId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'topic', 'industry', 'signalStrength', 'lifecyclePhase',
          'cadence', 'alertThreshold', 'latestDeltaNote', 'linkedBriefId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && isValidString(data.topic, 2, 240)
        && isValidString(data.industry, 2, 120)
        && data.signalStrength in ['Weak', 'Moderate', 'Strong']
        && data.lifecyclePhase in ['Emergence', 'Growth', 'Maturity', 'Decline']
        && data.cadence in ['Weekly', 'Monthly', 'Quarterly']
        && isValidString(data.alertThreshold, 2, 240)
        && isValidString(data.latestDeltaNote, 1, 1500)
        && data.linkedBriefId is string
        && data.linkedBriefId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/briefs/{briefId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(briefId);
      allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(briefId)
        && isOwner(userId)
        && isValidBrief(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(briefId)
        && isOwner(userId)
        && isValidBrief(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'topic', 'industry', 'briefType', 'signalStrength', 'lifecyclePhase',
            'leadTimeMonths', 'confidencePct', 'executiveSummary', 'drivers',
            'barriers', 'metrics', 'sections', 'sources', 'history', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'signalStrength', 'lifecyclePhase', 'history', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly(['isArchived', 'updatedAt'])
        );
      allow delete: if isVerifiedUser()
        && isValidId(briefId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
    }

    match /users/{userId}/watchlist/{signalId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(signalId);
      allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(signalId)
        && isOwner(userId)
        && isValidWatchlistSignal(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(signalId)
        && isOwner(userId)
        && isValidWatchlistSignal(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'signalStrength', 'lifecyclePhase', 'latestDeltaNote', 'linkedBriefId', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'cadence', 'alertThreshold', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser()
        && isValidId(signalId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
